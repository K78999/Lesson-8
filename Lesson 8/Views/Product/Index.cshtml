@model List<Lesson_8.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1>Danh sách sản phẩm</h1>
            <a href="@Url.Action("Create", "Product")" class="btn btn-primary">
                <i class="bi bi-plus"></i> Thêm sản phẩm mới
            </a>
        </div>
    </div>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ViewBag.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            Không có sản phẩm nào. <a href="@Url.Action("Create", "Product")">Thêm sản phẩm mới</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Hình ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Giá (VNĐ)</th>
                        <th>Ngày tạo</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(product.ImagePath))
                                {
                                    <img src="@product.ImagePath" alt="@product.Name" class="img-thumbnail" style="width: 80px; height: 80px; object-fit: cover;">
                                }
                                else
                                {
                                    <img src="/images/no-image.png" alt="No image" class="img-thumbnail" style="width: 80px; height: 80px;">
                                }
                            </td>
                            <td>@product.Name</td>
                            <td>@product.Price.ToString("N0")</td>
                            <td>@product.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a href="@Url.Action("Edit", "Product", new { id = product.Id })" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i> Sửa
                                </a>
                                <a href="@Url.Action("Delete", "Product", new { id = product.Id })" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .img-thumbnail {
        border: 1px solid #ddd;
        border-radius: 4px;
        padding: 5px;
        background-color: #f8f9fa;
    }
</style>
